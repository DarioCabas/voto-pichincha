---
// Cómo leer la comparación + la comparación interactiva (React + shadcn).
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Alert, AlertTitle, AlertDescription } from '@/components/ui/alert';
import { Bot } from 'lucide-react';
import { Comparacion } from './react/Comparacion';
import { MarcaViab } from './react/Marcas';
interface Props { candidatos: any[]; temas: { id: string; nombre: string }[]; auto?: boolean }
const { candidatos, temas, auto = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const colores = [
  ['alta', 'Es algo que este cargo puede hacer por sí mismo.'],
  ['media', 'Necesita el apoyo de otra autoridad, o dinero que no controla.'],
  ['baja', 'Le toca a otro nivel de gobierno, o es poco realista.'],
] as const;
// Solo lo que la comparación necesita (lo demás va en las fichas)
const datos = candidatos.map(({ id, lista, partido, titulo, subtitulo, enfoque, tabla, metas, pdf, cne, notas, verif }) => ({ id, lista, partido, titulo, subtitulo, enfoque, tabla, metas, pdf, cne, notas: notas?.slice(0, 1), verif: verif?.map((v) => ({ calificacion: v.calificacion, fuente: v.fuente })) }));
---

<div class="mt-8 grid gap-3 lg:grid-cols-[1fr_minmax(0,22rem)]">
  <Card className="gap-3">
    <CardHeader>
      <CardTitle className="text-base">Cómo leer esta comparación</CardTitle>
      <CardDescription className="text-[0.9rem]">
        Cada línea es una propuesta del plan. El símbolo dice si quien la promete puede cumplirla. <b class="font-semibold text-foreground">Toca una propuesta</b> para ver qué promete, por qué tiene ese símbolo y en qué página del plan lo dice.
      </CardDescription>
    </CardHeader>
    <CardContent>
      <ul class="grid list-none gap-2 p-0 text-[0.9rem] sm:grid-cols-3">
        {colores.map(([v, d]) => (
          <li><MarcaViab v={v} texto className="font-semibold" /><span class="mt-0.5 block text-muted-foreground">{d}</span></li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-muted-foreground"><a href={`${base}/metodologia/`}>Cómo decidimos cada símbolo</a></p>
    </CardContent>
  </Card>
  {auto && (
    <Alert className="h-fit">
      <Bot aria-hidden="true" />
      <AlertTitle>Resumen hecho con IA</AlertTitle>
      <AlertDescription>Una inteligencia artificial resumió estos planes y ninguna persona los revisó aún. Por eso cada propuesta trae la frase exacta del plan y su página: compruébala ahí.</AlertDescription>
    </Alert>
  )}
</div>

<Comparacion client:load candidatos={datos} temas={temas} />
