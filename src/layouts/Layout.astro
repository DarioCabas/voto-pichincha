---
import '@/styles/global.css';
import { SelectorIr } from '@/components/SelectorIr';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { PROVINCIAS, provPath } from '../data/dignidades.js';
import { dignidadesDe } from '../lib/datos.js';
interface Props { title: string; activo?: string; prov?: string }
const { title, activo, prov = 'pichincha' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pbase = base + provPath(prov);
const nombreProv = PROVINCIAS.find((p) => p.slug === prov)?.nombre ?? 'Pichincha';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} · Voto Informado {nombreProv}</title>
    <!-- Tema oscuro según el sistema, antes de pintar para evitar parpadeo -->
    <script is:inline>
      (() => {
        const m = matchMedia('(prefers-color-scheme: dark)');
        const set = () => document.documentElement.classList.toggle('dark', m.matches);
        set();
        m.addEventListener('change', set);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Saltar al contenido</a>
    <header class="border-b bg-background/95 backdrop-blur md:sticky md:top-0 md:z-30">
      <div class="mx-auto flex max-w-[1320px] flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a href={`${pbase}/`} class="mr-auto font-semibold text-foreground no-underline">
          Voto Informado <span class="font-normal text-muted-foreground">· Seccionales 2027</span>
        </a>
        <label class="flex items-center gap-2 text-sm text-muted-foreground">
          Provincia
          <SelectorIr etiqueta="Cambiar de provincia" valor={`${base}${provPath(prov)}/`} opciones={PROVINCIAS.map((p) => ({ valor: `${base}${provPath(p.slug)}/`, texto: p.nombre }))} className="text-foreground" />
        </label>
      </div>
      <nav aria-label={`Cargos en ${nombreProv}`} class="mx-auto max-w-[1320px] px-4 pb-2">
        <ul class="-mx-1 flex list-none gap-1 overflow-x-auto p-0 px-1 pb-1 [scrollbar-width:none]">
          {dignidadesDe(prov).map((d) => (
            <li>
              <a
                href={`${pbase}/${d.slug}/`}
                aria-current={activo === d.slug ? 'page' : undefined}
                class={cn(buttonVariants({ variant: activo === d.slug ? 'default' : 'ghost', size: 'sm' }), 'no-underline', activo !== d.slug && 'text-muted-foreground')}
              >
                {d.nombre}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenido" class="mx-auto max-w-[1320px] px-4 pb-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-[1320px] border-t px-4 py-8 text-sm text-muted-foreground">
      <p class="max-w-[70ch]">
        Los planes son los que cada candidatura entregó al CNE para las elecciones seccionales 2027, sin cambios. El color de cada propuesta es una guía para entender quién puede cumplirla, no una opinión legal.
      </p>
      <p class="mt-2"><a href={`${base}/metodologia/`}>Cómo hicimos este sitio</a></p>
    </footer>
    <script>
      // Selectores que llevan a otra página (provincia, cantón, parroquia)
      document.querySelectorAll<HTMLSelectElement>('select[data-ir]').forEach((s) => s.addEventListener('change', () => (location.href = s.value)));
    </script>
  </body>
</html>
