---
// Inicio de una provincia: cómo usar el sitio, buscador y cargos publicados.
import Layout from '../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Input } from '@/components/ui/input';
import { PROVINCIAS, provPath } from '../data/dignidades.js';
import { candidatos as prefectos } from '../data/prefecto.js';
import { dignidadesDe, territorios, titulo } from '../lib/datos.js';

const { prov = 'pichincha' } = Astro.props;
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
const base = raiz + provPath(prov);
const nombreProv = PROVINCIAS.find((p) => p.slug === prov)?.nombre;
const dignidades = dignidadesDe(prov);
const indice = [];
const resumen = {};
if (prov === 'pichincha') {
  for (const c of prefectos) indice.push({ n: `${c.prefecto} / ${c.vice}`, p: c.partido, l: c.lista, d: 'Prefectura', u: `/prefectura/#f-l${c.lista.replace(/\W/g, '')}` });
  resumen.prefectura = { listas: prefectos.length, terr: 'toda la provincia', ia: false };
}
for (const d of dignidades.filter((x) => x.slug !== 'prefectura' || prov !== 'pichincha')) {
  const ts = territorios(d, prov);
  if (!d.territorio) {
    const cands = ts.flatMap((t) => t.cands);
    resumen[d.slug] = { listas: cands.length, terr: 'toda la provincia', ia: cands.some((c) => c.auto) };
    for (const c of cands) indice.push({ n: (c.personas ?? []).map((p) => p.nombre).join(', ') || c.titulo, p: c.partido, l: c.lista, d: d.nombre, u: `/${d.slug}/#f-${c.id}` });
    continue;
  }
  const unidad = d.territorio === 'sub' ? (d.slug === 'junta-parroquial' ? 'parroquias' : 'circunscripciones') : d.territorio === 'grupo' ? 'listas nacionales' : 'cantones';
  resumen[d.slug] = { listas: ts.reduce((a, t) => a + t.n, 0), terr: `${ts.length} ${unidad}`, ia: ts.some((t) => t.cands.some((c) => c.auto)) };
  for (const t of ts) for (const c of t.cands)
    indice.push({ n: (c.personas ?? []).map((p) => p.nombre).join(', ') || c.titulo, p: c.partido, l: c.lista, d: `${d.nombre} · ${titulo(t.sub ?? t.canton)}`, u: `/${d.slug}/${t.path}/#${'f-' + c.id}` });
}
const pasos = [
  ['Elige qué cargo quieres ver', 'Alcaldía, concejo, junta parroquial... Abajo te contamos qué hace cada uno.'],
  ['Elige tu cantón o parroquia', 'Verás a todas las candidaturas lado a lado, ordenadas por tema.'],
  ['Toca una propuesta', 'Te explicamos qué promete, si de verdad le toca cumplirla y en qué página del plan lo dice. Si la candidatura habló en un debate, verás también qué encontraron Ecuador Chequea y Lupa Media.'],
];
---

<Layout title="Inicio" prov={prov}>
  <section class="pt-6 md:pt-10">
    <h1 class="max-w-[20ch]">¿Qué proponen tus candidatos en {nombreProv}?</h1>
    <p class="mt-3 max-w-[62ch] text-base text-muted-foreground">
      Aquí puedes leer, en palabras simples, lo que cada candidatura prometió en el plan de trabajo que entregó al CNE, y saber si es algo que de verdad puede cumplir.
    </p>
    {prov !== 'pichincha' && (
      <p class="mt-2 text-sm text-muted-foreground">En {nombreProv}, por ahora solo están las alcaldías.</p>
    )}

    <div class="relative mt-6 max-w-xl">
      <label for="q" class="mb-1.5 block text-sm font-medium">Busca por nombre, partido o lugar</label>
      <Input id="q" type="search" placeholder={prov === 'pichincha' ? 'Ej.: Pabel Muñoz, Revolución Ciudadana, Cumbayá' : 'Ej.: nombre del candidato o del cantón'} autoComplete="off" className="h-11 text-base" />
      <ul id="res" class="mt-2 list-none overflow-hidden rounded-lg border bg-card p-0 empty:hidden"></ul>
    </div>
  </section>

  <section aria-labelledby="como" class="mt-10">
    <h2 id="como" class="mt-0">Cómo usar esta página</h2>
    <ol class="grid list-none gap-3 p-0 md:grid-cols-3">
      {pasos.map(([t, d], i) => (
        <li class="flex gap-3 rounded-xl border bg-card p-4">
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">{i + 1}</span>
          <div>
            <p class="font-medium">{t}</p>
            <p class="mt-0.5 text-sm text-muted-foreground">{d}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="cargos" class="mt-10">
    <h2 id="cargos" class="mt-0">Elige un cargo</h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {dignidades.map((d) => (
        <a href={`${base}/${d.slug}/`} class="group rounded-xl text-foreground no-underline focus-visible:outline-2 focus-visible:outline-ring">
          <Card className="h-full transition-colors group-hover:border-foreground/40">
            <CardHeader>
              <CardTitle className="text-lg">{d.nombre} <span aria-hidden="true" class="ml-1 inline-block text-muted-foreground transition-transform group-hover:translate-x-0.5">→</span></CardTitle>
              <CardDescription>{d.que}</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
              <span>{resumen[d.slug]?.listas ?? 0} candidaturas · {resumen[d.slug]?.terr}</span>
              <Badge variant="outline" className={resumen[d.slug]?.ia ? 'border-media/50' : 'border-alta/50'}>
                {resumen[d.slug]?.ia ? 'Resumen hecho con IA' : 'Resumen revisado'}
              </Badge>
            </CardContent>
          </Card>
        </a>
      ))}
    </div>
    <p class="mt-4 text-sm text-muted-foreground">
      <b class="font-medium text-foreground">¿Qué significan las etiquetas?</b> «Resumen revisado»: cada plan se leyó completo y se resumió por tema. «Resumen hecho con IA»: lo resumió una inteligencia artificial y cada propuesta trae la frase exacta del plan para que la compruebes. <a href={`${raiz}/metodologia/`}>Más detalles</a>
    </p>
  </section>

  <section class="mt-10 text-sm">
    <p class="text-muted-foreground">
      ¿Votas en otra provincia?{' '}
      {PROVINCIAS.filter((p) => p.slug !== prov).map((p, i, a) => <><a href={`${raiz}${provPath(p.slug)}/`}>{p.nombre}</a>{i < a.length - 1 ? ', ' : '.'}</>)}
    </p>
  </section>

  <script type="application/json" id="idx" set:html={JSON.stringify(indice)} />
  <script define:vars={{ base }}>
    const idx = JSON.parse(document.getElementById('idx').textContent);
    const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const hay = idx.map((x) => norm(`${x.n} ${x.p} ${x.d} lista ${x.l}`));
    const q = document.getElementById('q'), res = document.getElementById('res');
    q.addEventListener('input', () => {
      const terms = norm(q.value).split(/\s+/).filter(Boolean);
      res.innerHTML = '';
      if (!terms.length) return;
      const hits = idx.filter((_, i) => terms.every((t) => hay[i].includes(t))).slice(0, 12);
      for (const h of hits) {
        const li = document.createElement('li');
        li.className = 'border-b last:border-b-0';
        li.innerHTML = '<a class="block px-4 py-2.5 text-foreground no-underline hover:bg-muted"><b class="block text-sm font-medium"></b><span class="text-xs text-muted-foreground"></span></a>';
        li.querySelector('a').href = base + h.u;
        li.querySelector('b').textContent = h.n;
        li.querySelector('span').textContent = `${h.d} · Lista ${h.l} · ${h.p}`;
        res.append(li);
      }
      if (!hits.length) res.innerHTML = '<li class="px-4 py-2.5 text-sm text-muted-foreground">No encontramos nada con esa búsqueda. Prueba con un apellido o el nombre del cantón.</li>';
    });
  </script>
</Layout>
