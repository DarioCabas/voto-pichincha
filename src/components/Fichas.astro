---
// Fichas completas de cada candidatura (React + shadcn Accordion).
import { Fichas as F } from './react/Fichas';
interface Props { candidatos: any[]; temas: { id: string; nombre: string }[] }
const { candidatos, temas } = Astro.props;
const datos = candidatos.map(({ id, lista, partido, titulo, personas, estructura, inversion, metas, primeros100, detalle, propuestas, objetivos, notas, verif, pdf, cne }) =>
  ({ id, lista, partido, titulo, personas, estructura, inversion, metas, primeros100, detalle, propuestas, objetivos, notas, verif, pdf, cne }));
---

<F client:load candidatos={datos} temas={temas} />
